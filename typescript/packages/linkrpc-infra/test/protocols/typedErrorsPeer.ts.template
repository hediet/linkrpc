import assert from 'node:assert/strict';
import { applicationError, isRpcFailure, NonCompliantServerError, RpcError, type InterfaceClient, type InterfaceHandlers } from '@hediet/linkrpc';
import { contract } from './contract';
import { startRustPeer, within } from '../../rustPeer';

const [mode, binary, hash] = process.argv.slice(2);
assert.equal(contract.schemaHash, hash);
assert.ok(binary);

const unhandledModes = ['unknown', 'protocol', 'spoof-transport', 'wrong-code', 'raw-unknown-code'] as const;
const nonCompliantModes = [
    'unknown-type', 'missing-type', 'wrong-data', 'missing-data', 'wrong-variant-code',
    'extra-data', 'missing-nullable', 'extra-property', 'extra-envelope', 'bad-recursion',
    'raw-invalid', 'raw-missing-data', 'raw-null-required', 'raw-bad-union',
] as const;
const rawModes = ['raw', 'raw-absent', 'raw-null', 'raw-value', 'raw-string', 'raw-number'] as const;

function wireError(mode: string): RpcError {
    switch (mode) {
        case 'unknown': return new RpcError('Unknown', 9001, { kept: true });
        case 'protocol': return new RpcError('Protocol failure', -32602);
        case 'spoof-transport': return new RpcError('Connection closed', -32402);
        case 'changed-message': return new RpcError('Dynamic diagnostic', __MISSING__, {
            type: 'Missing', data: { resource: 'file' },
        });
        case 'unknown-type': return new RpcError('Missing', __MISSING__, { type: 'Undeclared', data: { resource: 'file' } });
        case 'missing-type': return new RpcError('Missing', __MISSING__, { data: { resource: 'file' } });
        case 'wrong-code': return new RpcError('Missing', 9001, { type: 'Missing', data: { resource: 'file' } });
        case 'wrong-variant-code': return new RpcError('Missing', __NUMERIC__, { type: 'Missing', data: { resource: 'file' } });
        case 'wrong-data': return new RpcError('Missing', __MISSING__, { type: 'Missing', data: { resource: 42 } });
        case 'missing-data': return new RpcError('Missing', __MISSING__, { type: 'Missing' });
        case 'extra-data': return new RpcError('Busy', __BUSY__, { type: 'Busy', data: null });
        case 'missing-nullable': return new RpcError('Nullable', __NULLABLE__, { type: 'Nullable' });
        case 'extra-property': return new RpcError('Missing', __MISSING__, { type: 'Missing', data: { resource: 'file', extra: true } });
        case 'extra-envelope': return new RpcError('Missing', __MISSING__, { type: 'Missing', data: { resource: 'file' }, extra: true });
        case 'bad-recursion': return new RpcError('Recursive', __RECURSIVE__, {
            type: 'Recursive', data: { label: 'root', children: [{ label: 42, children: [] }] },
        });
        case 'raw': return new RpcError('Retry after maintenance', -32001, { retryAfter: 5 });
        case 'raw-absent': return new RpcError('Optional diagnostic', -32002);
        case 'raw-null': return new RpcError('Optional diagnostic', -32002, null);
        case 'raw-value': return new RpcError('Optional diagnostic', -32002, { arbitrary: ['data'] });
        case 'raw-string': return new RpcError('Union diagnostic', -32003, 'file');
        case 'raw-number': return new RpcError('Union diagnostic', -32003, 5);
        case 'raw-unknown-code': return new RpcError('Retry after maintenance', -32004, { retryAfter: 5 });
        case 'raw-invalid': return new RpcError('Retry after maintenance', -32001, { retryAfter: 'soon' });
        case 'raw-missing-data': return new RpcError('Retry after maintenance', -32001);
        case 'raw-null-required': return new RpcError('Retry after maintenance', -32001, null);
        case 'raw-bad-union': return new RpcError('Union diagnostic', -32003, false);
        default: throw new Error(`Unexpected fixture mode: ${mode}`);
    }
}

function checkStaticTypes(client: InterfaceClient<typeof contract>): void {
    // @ts-expect-error generated params require a string mode
    client.check({ mode: 123 });
    // @ts-expect-error generated application data requires a string resource
    contract.members.check.errors[0].create({ resource: 123 });
    // @ts-expect-error a data-less error does not accept data
    contract.members.check.errors[1].create({});
    // @ts-expect-error the raw error body requires a numeric retry delay
    contract.members.check.errors[5].create({ message: 'Retry', data: { retryAfter: 'soon' } });
    const wrongErrorHandler: InterfaceHandlers<typeof contract> = {
        // @ts-expect-error an undeclared application error cannot be returned by a typed handler
        check: () => applicationError(9001, 'Undeclared').create(),
    };
    void wrongErrorHandler;
    const wrongHandler: InterfaceHandlers<typeof contract> = {
        // @ts-expect-error generated success return type is string, not number
        check: () => 42,
    };
    void wrongHandler;
}
void checkStaticTypes;

const peer = await startRustPeer(binary, [mode === 'client' ? 'server' : 'client']);
const client = peer.connection.get(contract);
const resultClient = peer.connection.getResultClient(contract);
try {
    if (mode === 'client') {
        peer.start();
        assert.equal(await within(client.check({ mode: 'success' }), 'success'), 'ok');
        assert.equal(await resultClient.check({ mode: 'success' }), 'ok');
        const missing = await client.check({ mode: 'missing' });
        if (!isRpcFailure(missing)) throw new Error('expected Missing');
        assert.equal(missing.error.code, __MISSING__);
        if (missing.error.code !== __MISSING__ || missing.error.type !== 'Missing') throw new Error('expected Missing type');
        const resource: string = missing.error.data.resource;
        assert.equal(resource, 'file');
        // @ts-expect-error a narrowed Missing payload has no unexpected property
        void missing.error.data.unexpected;
        const safeMissing = await resultClient.check({ mode: 'missing' });
        if (!isRpcFailure(safeMissing) || safeMissing.error.kind !== 'application') {
            throw new Error('expected checked application failure');
        }
        if (safeMissing.error.error.code !== __MISSING__ || safeMissing.error.error.type !== 'Missing') throw new Error('expected checked Missing');
        assert.equal(safeMissing.error.error.data.resource, 'file');

        for (const [mode, code, data] of [
            ['busy', __BUSY__, undefined],
            ['nullable', __NULLABLE__, null],
            ['recursive', __RECURSIVE__, { label: 'root', children: [{ label: 'leaf', children: [] }] }],
            ['numeric', __NUMERIC__, 42.5],
        ] as const) {
            const result = await client.check({ mode });
            if (!isRpcFailure(result)) throw new Error(`expected ${mode}`);
            assert.equal(result.error.code, code);
            assert.deepEqual(result.error.data, data);
        }
        const changedMessage = await client.check({ mode: 'changed-message' });
        if (!isRpcFailure(changedMessage) || !contract.members.check.errors[0].is(changedMessage)) {
            throw new Error('expected Missing despite dynamic message');
        }
        assert.equal(changedMessage.error.data.resource, 'file');
        for (const mode of rawModes) {
            const result = await client.check({ mode });
            if (!isRpcFailure(result)) throw new Error(`expected handled ${mode}`);
            const expected = wireError(mode);
            assert.equal(result.error.code, expected.code);
            assert.equal(result.error.message, expected.message);
            assert.deepEqual(result.error.data, expected.data);
            assert.equal(Object.hasOwn(result.error, 'data'), expected.hasData);
            assert.equal(Object.hasOwn(result.error, 'type'), false);
            if (result.error.code === -32001) {
                const retryAfter: number = result.error.data.retryAfter;
                assert.equal(retryAfter, 5);
                // @ts-expect-error a code-narrowed retry payload has no resource
                void result.error.data.resource;
            }
        }
        for (const mode of unhandledModes) {
            const result = await resultClient.check({ mode });
            if (!isRpcFailure(result) || result.error.kind !== 'generic' || result.error.error.kind !== 'remote') {
                throw new Error(`${mode}: expected generic remote`);
            }
            const expected = wireError(mode);
            assert.equal(result.error.error.code, expected.code);
            assert.equal(result.error.error.message, expected.message);
            assert.deepEqual(result.error.error.data, expected.data);
        }
        for (const mode of nonCompliantModes) {
            const result = await resultClient.check({ mode });
            if (mode === 'extra-property') {
                if (!isRpcFailure(result) || result.error.kind !== 'application'
                    || result.error.error.code !== 1 || result.error.error.type !== 'Missing') {
                    throw new Error('expected Missing after the generated decoder strips extra fields');
                }
                assert.deepEqual(result.error.error.data, { resource: 'file' });
                continue;
            }
            if (!isRpcFailure(result) || result.error.kind !== 'generic'
                || !(result.error.error instanceof NonCompliantServerError)) {
                throw new Error(`${mode}: expected noncompliant server`);
            }
            const expected = wireError(mode);
            assert.deepEqual(result.error.error.original, {
                code: expected.code, message: expected.message,
                ...(expected.hasData ? { data: expected.data } : {}),
            });
            assert.ok(result.error.error.issues.length > 0);
            assert.ok(result.error.error.issues.every((issue) => typeof issue.path === 'string' && issue.message.length > 0));
            if (mode === 'raw-invalid') {
                assert.ok(result.error.error.issues.some((issue) => issue.path === '/data/retryAfter'));
            }
            await assert.rejects(client.check({ mode }), NonCompliantServerError);
        }
        const invalidEncoding = await resultClient.check({ mode: 'invalid-encoding' });
        if (!isRpcFailure(invalidEncoding) || invalidEncoding.error.kind !== 'generic' || invalidEncoding.error.error.kind !== 'remote') {
            throw new Error('invalid producer data must fail explicitly');
        }
        assert.equal(invalidEncoding.error.error.code, -32603);
        await assert.rejects(client.check({ mode: 'protocol' }), { code: -32602 });
        await peer.stop();
        const disconnected = await resultClient.check({ mode: 'success' });
        if (!isRpcFailure(disconnected) || disconnected.error.kind !== 'generic') throw new Error('closed connection must fail');
        assert.equal(disconnected.error.error.kind, 'local');
    } else {
        const called: string[] = [];
        peer.connection.register(contract, {
            check: ({ mode }) => {
                called.push(mode);
                switch (mode) {
                    case 'success': return 'ok';
                    case 'missing': return contract.members.check.errors[0].create({ resource: 'file' });
                    case 'busy': return contract.members.check.errors[1].create();
                    case 'nullable': return contract.members.check.errors[2].create(null);
                    case 'recursive': return contract.members.check.errors[3].create({
                        label: 'root', children: [{ label: 'leaf', children: [] }],
                    });
                    case 'numeric': return contract.members.check.errors[4].create(42.5);
                    case 'invalid-encoding': return contract.members.check.errors[4].create(NaN);
                    case 'raw': return contract.members.check.errors[5].create({
                        message: 'Retry after maintenance', data: { retryAfter: 5 },
                    });
                    case 'raw-absent': return contract.members.check.errors[6].create({ message: 'Optional diagnostic' });
                    case 'raw-null': return contract.members.check.errors[6].create({ message: 'Optional diagnostic', data: null });
                    case 'raw-value': return contract.members.check.errors[6].create({ message: 'Optional diagnostic', data: { arbitrary: ['data'] } });
                    case 'raw-string': return contract.members.check.errors[7].create({ message: 'Union diagnostic', data: 'file' });
                    case 'raw-number': return contract.members.check.errors[7].create({ message: 'Union diagnostic', data: 5 });
                    case 'disconnect':
                        peer.disconnect();
                        return new Promise<never>(() => {});
                    default: throw wireError(mode);
                }
            },
        });
        peer.start();
        const [code, signal] = await within(peer.exited, 'Rust typed client');
        assert.deepEqual({ code, signal }, { code: 0, signal: null }, peer.stderr());
        assert.deepEqual(called, [
            'success', 'missing', 'busy', 'nullable', 'recursive', 'numeric',
            'changed-message', ...rawModes, ...unhandledModes, ...nonCompliantModes, 'invalid-encoding', 'disconnect',
        ]);
    }
    console.log('typed errors verified');
} finally {
    await peer.stop();
}

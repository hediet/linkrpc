{
    "name": "@hediet/linkrpc-hub-daemon",
    "version": "0.0.1",
    "description": "Per-user LinkRPC hub daemon: supervised services, hot-reloaded config, local discovery, and OS autostart.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./client": {
            "import": "./dist/client.js",
            "types": "./dist/client.d.ts"
        },
        "./call-query": {
            "import": "./dist/call-query.js",
            "types": "./dist/call-query.d.ts"
        }
    },
    "bin": {
        "linkrpc-hub-daemon": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest --run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@hediet/linkrpc": "workspace:*",
        "@hediet/linkrpc-hub": "workspace:*",
        "@hediet/linkrpc-infra": "workspace:*",
        "@lydell/node-pty": "1.2.0-beta.15",
        "@xterm/addon-serialize": "0.14.0",
        "@xterm/headless": "6.0.0",
        "commander": "^12.1.0",
        "cross-spawn": "^7.0.6",
        "jsonc-parser": "^3.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^22.0.0",
        "tsdown": "^0.22.3",
        "tsx": "4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^3.0.0"
    }
}

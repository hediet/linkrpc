{
    "name": "@vscode/hubrpc-cli",
    "version": "0.0.1",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "hubrpc": "./dist/cli.js",
        "hub": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "cli": "tsx src/cli.ts",
        "build": "tsdown",
        "dev": "tsdown --watch",
        "generate:ahp-schema": "tsx generate-ahp-schema.ts",
        "test": "vitest --run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@vscode/hubrpc": "workspace:*",
        "@vscode/hubrpc-hub": "workspace:*",
        "commander": "^12.1.0",
        "ink": "^5.1.0",
        "ink-select-input": "^6.0.0",
        "ink-text-input": "^6.0.0",
        "react": "^18.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@vscode/hubrpc-client": "workspace:*",
        "@vscode/hubrpc-node-runner": "workspace:*",
        "@vscode/observables": "workspace:*",
        "@types/node": "^20.0.0",
        "@types/react": "^18.3.0",
        "tsdown": "^0.22.3",
        "tslib": "^2.8.1",
        "tsx": "4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^3.0.0"
    }

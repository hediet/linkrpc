{
    "name": "@hediet/linkrpc-eval-runner",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "eval-runner": "./dist/cli.js"
    },
    "scripts": {
        "start": "tsx src/cli.ts",
        "build": "tsdown",
        "test": "vitest --run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@hediet/linkrpc": "workspace:*",
        "@hediet/linkrpc-hub": "workspace:*",
        "@hediet/linkrpc-mcp": "workspace:*",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsdown": "^0.22.3",
        "tsx": "4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^3.0.0"
    }
}
